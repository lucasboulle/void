*
# do not ignore these files and directories
!.gitignore
!tmux
!tmux/**
!fish
!fish/**
!nvim
!nvim/**
!alacritty
!alacritty/**
!aerospace
!aerospace/**
!ghostty
!ghostty/**
!herdr
!herdr/**

# ignore everything in these directories
tmux/plugins/
fish/plugins/
herdr/plugins/
herdr/session-snapshots/

# ignore herdr and aerospace runtime and backup files
herdr/*.log
herdr/*.sock*
herdr/*.bak*
herdr/session.json
herdr/release-notes.json
herdr/.plugins.lock
aerospace/*.log
aerospace/*.bak*

# ignore lazy lockfile (gets regenerated automatically)
nvim/lazy-lock.json
